# Copy thành .env ở thư mục gốc project và thay các giá trị mẫu.
# Không commit .env. Docker Compose nạp file này; Visual Studio dùng User Secrets.

ConnectionStrings__DefaultConnection=Host=YOUR_POSTGRES_HOST;Port=5432;Database=postgres;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;SSL Mode=Require

# Chỉ bật khi chủ động muốn chạy migration và seed dữ liệu lúc khởi động.
Database__InitializeOnStartup=false

Jwt__SecretKey=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
Jwt__Issuer=SportsCenterAPI
Jwt__Audience=SportsCenterClient
Jwt__ExpireMinutes=15
Jwt__RefreshTokenExpireDays=7

# SendGrid HTTPS API: API key có quyền Mail Send và địa chỉ người gửi đã xác minh.
SendGrid__ApiKey=YOUR_SENDGRID_API_KEY
MailSettings__SenderName=Sports Center
MailSettings__SenderEmail=YOUR_VERIFIED_SENDER_EMAIL

PayOS__ClientId=YOUR_PAYOS_CLIENT_ID
PayOS__ApiKey=YOUR_PAYOS_API_KEY
PayOS__ChecksumKey=YOUR_PAYOS_CHECKSUM_KEY
PayOS__ReturnUrl=http://localhost:3000/payment/success
PayOS__CancelUrl=http://localhost:3000/payment/cancel

# API key lấy từ https://console.groq.com/keys.
AI__ApiKey=
AI__Model=openai/gpt-oss-20b
