# Copy thành .env ở thư mục gốc project và thay các giá trị mẫu.
# Không commit .env. Nên dùng Redis password ngẫu nhiên dạng chữ/số, không có dấu phẩy.
REDIS_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

# PostgreSQL hiện có của bạn; database vẫn là PostgreSQL, Redis chỉ lưu OTP.
ConnectionStrings__DefaultConnection=Host=YOUR_POSTGRES_HOST;Port=5432;Database=postgres;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;SSL Mode=Require

Jwt__SecretKey=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
Jwt__Issuer=SportsCenterAPI
Jwt__Audience=SportsCenterClient
Jwt__ExpireMinutes=15
Jwt__RefreshTokenExpireDays=7

MailSettings__Host=smtp.gmail.com
MailSettings__Port=587
MailSettings__SenderName=Sports Center
MailSettings__SenderEmail=YOUR_EMAIL
MailSettings__Password=YOUR_MAIL_APP_PASSWORD

PayOS__ClientId=YOUR_PAYOS_CLIENT_ID
PayOS__ApiKey=YOUR_PAYOS_API_KEY
PayOS__ChecksumKey=YOUR_PAYOS_CHECKSUM_KEY
PayOS__ReturnUrl=http://localhost:5173/payment/success
PayOS__CancelUrl=http://localhost:5173/payment/cancel

# API key lấy từ https://console.groq.com/keys (không dùng OpenAI API key).
# Có thể để trống API key nếu chưa test hai endpoint AI.
AI__ApiKey=
AI__Model=openai/gpt-oss-20b
